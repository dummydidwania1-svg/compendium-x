rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Data-privacy team's control/testing account (skshm.d26@gmail.com) — can
    // read every user's profile/sessions/evaluations, not just its own.
    // Mirrored in components/dashboard/DashboardContext.tsx (MASTER_ARCHIVE_UID).
    function isMasterArchive() {
      return signedIn() && request.auth.uid == 'nNNk7mQRYOSfSrBn03zNolbf1Pk2';
    }

    // True once the caller's own profile has been soft-deleted (see
    // DELETE /api/account). This is the fast, authoritative lockout for an
    // already-open session — it's checked on every request/listener-attach,
    // so it doesn't wait on the caller's ID token to expire or refresh.
    // A missing profile doc (get() returns no data) is treated as not
    // pending deletion, so this never blocks a brand-new user.
    function callerPendingDeletion() {
      return signedIn()
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('pendingDeletion', false) == true;
    }

    // Public case library, admin-only writes (via console/script)
    match /cases/{caseId} {
      allow read: if true;
      allow write: if false;
    }

    // User profile
    match /profiles/{userId} {
      allow read: if signedIn();
      // A deactivated account can no longer write anywhere, including its
      // own profile doc (so it can't clear the pendingDeletion flag itself).
      allow create, update, delete: if signedIn()
        && request.auth.uid == userId
        && !callerPendingDeletion();
    }

    // Practice goal tracker: one config doc per user, fully private (owner-only
    // read and write — deliberately NOT folded into `profiles`, whose read
    // rule is intentionally broad for forum author-display purposes).
    match /goals/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update, delete: if signedIn()
        && request.auth.uid == userId
        && !callerPendingDeletion();
    }

    // Goal history: frozen snapshots of past/completed goals, written by the
    // client whenever a goal is reset/replaced or reaches a terminal state.
    // Same owner-only direct-write shape as `goals` above — these are still
    // just user-owned config/outcome snapshots, not shared/graded data.
    match /goalHistory/{userId}/entries/{entryId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update, delete: if signedIn()
        && request.auth.uid == userId
        && !callerPendingDeletion();
    }

    // Sessions: clients read scoped to participants. All writes go through
    // /api/sessions* routes which use the Admin SDK (and bypass these rules).
    // `resource == null` allows reads of non-existent docs (e.g. lobby page's
    // initial existence check before calling POST /api/sessions).
    match /sessions/{sessionId} {
      allow read: if isMasterArchive() || (signedIn() && (
        resource == null ||
        resource.data.candidateId == request.auth.uid ||
        (resource.data.interviewerId is string && resource.data.interviewerId == request.auth.uid)
      ));
      allow write: if false;
    }

    // Evaluations: clients read scoped to participants. All writes go through
    // /api/evaluations which uses the Admin SDK.
    // Image-URL updates are still permitted client-side (dashboard upload UI).
    match /evaluations/{evaluationId} {
      allow read: if isMasterArchive() || (signedIn() && (
        resource.data.candidateId == request.auth.uid ||
        (resource.data.interviewerId is string && resource.data.interviewerId == request.auth.uid)
      ));

      allow create: if false;

      // Allow only workspace image URL updates (+updatedAt) by owner.
      allow update: if signedIn()
        && !callerPendingDeletion()
        && (
          resource.data.candidateId == request.auth.uid ||
          (
            !(resource.data.candidateId is string) &&
            (resource.data.interviewerId is string && resource.data.interviewerId == request.auth.uid)
          )
        )
        && request.resource.data.diff(resource.data).changedKeys()
             .hasOnly(['workspaceImageUrls', 'updatedAt']);

      allow delete: if false;
    }

    // Forum
    match /case_forums/{caseId} {
      allow read: if true;
      allow create, update, delete: if signedIn();

      match /threads/{threadId} {
        allow read: if true;

        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 3000;

        // Author can edit/delete own thread.
        // Any signed-in user can update voteScore, lastReplyAt, or editedAt (side-effects of replies/votes/edits).
        allow update: if signedIn() && (
          resource.data.authorId == request.auth.uid ||
          request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(['voteScore', 'lastReplyAt', 'updatedAt', 'editedAt'])
        );

        allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

        match /replies/{replyId} {
          allow read: if true;

          allow create: if signedIn()
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.body is string
            && request.resource.data.body.size() > 0
            && request.resource.data.body.size() <= 3000;

          allow update: if signedIn() && (
            resource.data.authorId == request.auth.uid ||
            request.resource.data.diff(resource.data).changedKeys().hasOnly(['voteScore'])
          );
          allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

          match /votes/{uid} {
            allow read: if true;
            allow create, update: if signedIn()
              && request.auth.uid == uid
              && request.resource.data.value in [-1, 1];
            allow delete: if signedIn() && request.auth.uid == uid;
          }
        }

        match /votes/{uid} {
          allow read: if true;
          allow create, update: if signedIn()
            && request.auth.uid == uid
            && request.resource.data.value in [-1, 1];
          allow delete: if signedIn() && request.auth.uid == uid;
        }
      }
    }

    // Weekly KPI report instrumentation: server-only, every write goes
    // through the Admin SDK (Vercel API routes or Cloud Functions). No
    // client-direct access in either direction — these are internal
    // aggregate/audit collections, never rendered to end users.
    match /activityHeartbeats/{docId} {
      allow read, write: if false;
    }

    match /caseViewAggregates/{dateKey} {
      allow read, write: if false;
    }

    match /weeklyReportRuns/{isoWeekKey} {
      allow read, write: if false;
    }

    // Per-user cached AI insight for POST /api/goal-insight, keyed by a
    // fingerprint of the input data — skips repeat Vertex AI calls when
    // nothing about the goal or logged cases has changed since the last
    // computation. Server-only, Admin SDK only — no client-direct access.
    match /goalInsightCache/{uid} {
      allow read, write: if false;
    }
  }
}
